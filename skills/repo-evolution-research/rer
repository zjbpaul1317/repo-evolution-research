#!/usr/bin/env bash
# Launcher for the repo-evolution-research Skill.
#
# Resolves the runtime environment from the script's PEP 723 metadata via uv,
# keeps the caller's working directory, and passes stdout, stderr and the CLI
# exit code through unchanged. Bootstrap diagnostics go to stderr only, and the
# failure paths rely on shell builtins so a minimal environment can still explain
# what is missing.

set -euo pipefail

MINIMUM_UV_MAJOR=0
MINIMUM_UV_MINOR=9

script_path="${BASH_SOURCE[0]}"
case "${script_path}" in
  */*) script_dir="${script_path%/*}" ;;
  *) script_dir="." ;;
esac
SKILL_DIR="$(cd -- "${script_dir}" >/dev/null 2>&1 && pwd)"
SCRIPT="${SKILL_DIR}/scripts/research.py"

if [ ! -f "${SCRIPT}" ]; then
  printf 'rer: 找不到 %s（Skill 安装不完整）\n' "${SCRIPT}" >&2
  exit 3
fi

if [ -n "${RER_PYTHON:-}" ]; then
  printf 'rer: 使用 RER_PYTHON=%s；依赖未经过锁文件与 uv 校验\n' "${RER_PYTHON}" >&2
  export RER_LAUNCHER=python-override
  exec "${RER_PYTHON}" "${SCRIPT}" "$@"
fi

if ! command -v uv >/dev/null 2>&1; then
  printf '%s\n' \
    "rer: 需要 uv >= ${MINIMUM_UV_MAJOR}.${MINIMUM_UV_MINOR}，但当前 PATH 中没有 uv。" \
    "安装：curl -LsSf https://astral.sh/uv/install.sh | sh" \
    "企业环境与离线准备见 references/setup.md。" >&2
  exit 3
fi

uv_version="$(uv --version 2>/dev/null || true)"
uv_version="${uv_version%%$'\n'*}"
if [[ "${uv_version}" =~ ^uv[[:space:]]+([0-9]+)\.([0-9]+) ]]; then
  uv_major="${BASH_REMATCH[1]}"
  uv_minor="${BASH_REMATCH[2]}"
else
  printf 'rer: 无法识别 uv 版本：%s\n' "${uv_version:-<empty>}" >&2
  exit 3
fi

if [ "${uv_major}" -lt "${MINIMUM_UV_MAJOR}" ] ||
  { [ "${uv_major}" -eq "${MINIMUM_UV_MAJOR}" ] && [ "${uv_minor}" -lt "${MINIMUM_UV_MINOR}" ]; }; then
  printf 'rer: 需要 uv >= %s.%s，当前为 %s\n' \
    "${MINIMUM_UV_MAJOR}" "${MINIMUM_UV_MINOR}" "${uv_version}" >&2
  exit 3
fi

if ! uv run --locked --no-build --script "${SCRIPT}" --help >/dev/null; then
  printf '%s\n' \
    "rer: uv 无法准备运行环境。常见原因与处理：" \
    "  - 内联依赖与锁文件不一致：在 Skill 目录执行 uv lock --script scripts/research.py" \
    "  - 网络不可用：设置 UV_OFFLINE=1 并使用预热缓存，或配置企业 PyPI 镜像" \
    "  - 平台或解释器没有预编译 wheel：改用受支持的 Python / 平台" \
    "详见 references/setup.md。" >&2
  exit 3
fi

export RER_LAUNCHER=uv-locked
exec uv run --locked --no-build --script "${SCRIPT}" "$@"
