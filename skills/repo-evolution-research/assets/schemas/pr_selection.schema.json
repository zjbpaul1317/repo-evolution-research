{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/pr_selection.schema.json",
  "title": "Deterministic pull request deep-read selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "repository",
    "activity_window",
    "quota",
    "candidates",
    "counts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_quota",
        "merged_quota",
        "open_quota",
        "max_deep_entities",
        "deep_entities_used"
      ],
      "properties": {
        "pr_quota": {
          "type": "integer",
          "minimum": 0
        },
        "merged_quota": {
          "type": "integer",
          "minimum": 0
        },
        "open_quota": {
          "type": "integer",
          "minimum": 0
        },
        "max_deep_entities": {
          "type": "integer",
          "minimum": 0
        },
        "deep_entities_used": {
          "type": "integer",
          "minimum": 0
        },
        "agent_pr_reserve": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "selected",
        "merged_selected",
        "open_selected",
        "skipped_quota",
        "skipped_unchanged",
        "failed",
        "not_attempted"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "merged_selected": {
          "type": "integer",
          "minimum": 0
        },
        "open_selected": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_quota": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_attempted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "entity_id",
        "bucket",
        "score",
        "score_components",
        "selection_reason",
        "selected",
        "skipped_reason",
        "status"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "enum": [
            "merged",
            "open",
            "closed"
          ]
        },
        "score": {
          "type": "integer"
        },
        "score_components": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "selection_reason": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected": {
          "type": "boolean"
        },
        "skipped_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "selected",
            "skipped_quota",
            "skipped_unchanged",
            "failed",
            "not_attempted"
          ]
        }
      }
    }
  }
}
