{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/source_envelope.schema.json",
  "title": "Imported external source envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_url",
    "retrieved_at",
    "provider",
    "content",
    "entity_id"
  ],
  "properties": {
    "schema_version": { "const": "1.3" },
    "source_url": { "type": "string", "format": "uri" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "minLength": 1 },
    "content_type": { "enum": ["text/markdown", "text/plain"] },
    "content": { "type": "string", "minLength": 1 },
    "entity_id": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["external_page", "api_response"] },
    "source_revision": { "type": ["string", "null"] },
    "completeness": { "enum": ["complete", "truncated", "partial", "unknown"] },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "to_id", "type", "basis", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from_id": { "type": "string", "minLength": 1 },
        "to_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "mentions",
            "addresses",
            "closing_reference",
            "implements_part_of",
            "contains_commit",
            "release_note_mentions",
            "verified_in_release",
            "documents",
            "supersedes",
            "reverts",
            "duplicates",
            "related_candidate"
          ]
        },
        "basis": { "enum": ["api_explicit", "text_explicit", "agent_inferred"] },
        "verification": { "enum": ["candidate", "verified", "disputed"] },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scope": { "type": ["object", "null"] }
      }
    }
  }
}
