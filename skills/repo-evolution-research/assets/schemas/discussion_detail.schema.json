{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/discussion_detail.schema.json",
  "title": "Deep read of a single discussion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "repository",
    "number",
    "url",
    "title",
    "author",
    "category",
    "closed",
    "closed_at",
    "state_reason",
    "created_at",
    "updated_at",
    "upvote_count",
    "is_answered",
    "answer_comment_id",
    "scope",
    "selection_reason",
    "role_hints",
    "body",
    "comments",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "closed": {
      "type": "boolean"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "state_reason": {
      "enum": [
        "resolved",
        "outdated",
        "duplicate",
        "reopened",
        null
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "upvote_count": {
      "type": "integer",
      "minimum": 0
    },
    "is_answered": {
      "type": "boolean"
    },
    "answer_comment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "selection_reason": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "role_hints": {
      "$ref": "#/$defs/role_hints"
    },
    "body": {
      "$ref": "#/$defs/text_ref"
    },
    "comments": {
      "$ref": "#/$defs/comment_section"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "text_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview",
        "sha256",
        "bytes",
        "preview_truncated"
      ],
      "properties": {
        "preview": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "preview_truncated": {
          "type": "boolean"
        }
      }
    },
    "scope": {
      "enum": [
        "in_window",
        "context",
        "current_backlog"
      ]
    },
    "role_hints": {
      "type": "array",
      "items": {
        "enum": [
          "rfc",
          "design",
          "proposal",
          "architecture",
          "feature_request",
          "enhancement",
          "roadmap"
        ]
      },
      "uniqueItems": true
    },
    "section_status": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "not_requested"
      ]
    },
    "reply_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "database_id",
        "author",
        "created_at",
        "updated_at",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "database_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "body": {
          "$ref": "#/$defs/text_ref"
        }
      }
    },
    "comment_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "database_id",
        "author",
        "created_at",
        "updated_at",
        "is_answer",
        "body",
        "replies_status",
        "replies_truncated",
        "replies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "database_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "is_answer": {
          "type": "boolean"
        },
        "body": {
          "$ref": "#/$defs/text_ref"
        },
        "replies_status": {
          "$ref": "#/$defs/section_status"
        },
        "replies_truncated": {
          "type": "boolean"
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reply_item"
          }
        }
      }
    },
    "comment_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fetched",
        "total_known",
        "truncated",
        "truncation_reason",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "total_known": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment_item"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail",
        "body",
        "comments"
      ],
      "properties": {
        "detail": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "body": {
          "$ref": "#/$defs/section_status"
        },
        "comments": {
          "$ref": "#/$defs/section_status"
        }
      }
    }
  }
}
