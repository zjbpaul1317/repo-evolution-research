{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/pr_detail.schema.json",
  "title": "Deep read of a single pull request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "repository",
    "number",
    "url",
    "title",
    "author",
    "state",
    "draft",
    "merged",
    "merged_at",
    "created_at",
    "updated_at",
    "closed_at",
    "base_sha",
    "head_sha",
    "head_sha_end",
    "head_changed",
    "merge_commit_sha",
    "comparator",
    "additions",
    "deletions",
    "changed_files",
    "commits_count",
    "comments_count",
    "review_comments_count",
    "selection_reason",
    "body",
    "files",
    "commits",
    "issue_comments",
    "reviews",
    "review_comments",
    "diff",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "type": "boolean"
    },
    "merged": {
      "type": "boolean"
    },
    "merged_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha_end": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_changed": {
      "type": "boolean"
    },
    "merge_commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparator": {
      "const": "github_pr_files"
    },
    "additions": {
      "type": "integer",
      "minimum": 0
    },
    "deletions": {
      "type": "integer",
      "minimum": 0
    },
    "changed_files": {
      "type": "integer",
      "minimum": 0
    },
    "commits_count": {
      "type": "integer",
      "minimum": 0
    },
    "comments_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_comments_count": {
      "type": "integer",
      "minimum": 0
    },
    "selection_reason": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "$ref": "#/$defs/text_ref"
    },
    "files": {
      "$ref": "#/$defs/file_section"
    },
    "commits": {
      "$ref": "#/$defs/commit_section"
    },
    "issue_comments": {
      "$ref": "#/$defs/comment_section"
    },
    "reviews": {
      "$ref": "#/$defs/review_section"
    },
    "review_comments": {
      "$ref": "#/$defs/review_comment_section"
    },
    "diff": {
      "$ref": "#/$defs/diff_ref"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "text_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview",
        "sha256",
        "bytes",
        "preview_truncated"
      ],
      "properties": {
        "preview": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "preview_truncated": {
          "type": "boolean"
        }
      }
    },
    "section_status": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "not_requested"
      ]
    },
    "file_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fetched",
        "total_known",
        "truncated",
        "truncation_reason",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "total_known": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_item"
          }
        }
      }
    },
    "file_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "status",
        "additions",
        "deletions",
        "changes",
        "patch_status",
        "patch",
        "previous_filename",
        "sha"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "integer",
          "minimum": 0
        },
        "patch_status": {
          "enum": [
            "available",
            "missing",
            "empty"
          ]
        },
        "patch": {
          "anyOf": [
            {
              "$ref": "#/$defs/text_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "commit_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fetched",
        "total_known",
        "truncated",
        "truncation_reason",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "total_known": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit_item"
          }
        }
      }
    },
    "commit_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "message",
        "author",
        "date"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "$ref": "#/$defs/text_ref"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "comment_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fetched",
        "total_known",
        "truncated",
        "truncation_reason",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "total_known": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment_item"
          }
        }
      }
    },
    "comment_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "user",
        "created_at",
        "updated_at",
        "author_association",
        "body"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "author_association": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "$ref": "#/$defs/text_ref"
        }
      }
    },
    "review_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fetched",
        "total_known",
        "truncated",
        "truncation_reason",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "total_known": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_item"
          }
        }
      }
    },
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "user",
        "state",
        "submitted_at",
        "commit_id",
        "outdated",
        "resolution",
        "body"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "commit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outdated": {
          "type": "boolean"
        },
        "resolution": {
          "enum": [
            "unknown"
          ]
        },
        "body": {
          "$ref": "#/$defs/text_ref"
        }
      }
    },
    "review_comment_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fetched",
        "total_known",
        "truncated",
        "truncation_reason",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/section_status"
        },
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "total_known": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_comment_item"
          }
        }
      }
    },
    "review_comment_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "user",
        "path",
        "line",
        "original_line",
        "commit_id",
        "outdated",
        "in_reply_to_id",
        "pull_request_review_id",
        "diff_hunk",
        "body"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "original_line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "commit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outdated": {
          "type": "boolean"
        },
        "in_reply_to_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pull_request_review_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "diff_hunk": {
          "$ref": "#/$defs/text_ref"
        },
        "body": {
          "$ref": "#/$defs/text_ref"
        }
      }
    },
    "diff_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sha256",
        "bytes",
        "truncated"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "budget_capped",
            "not_requested",
            "unavailable"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail",
        "files",
        "commits",
        "issue_comments",
        "reviews",
        "review_comments"
      ],
      "properties": {
        "detail": {
          "$ref": "#/$defs/section_status"
        },
        "files": {
          "$ref": "#/$defs/section_status"
        },
        "commits": {
          "$ref": "#/$defs/section_status"
        },
        "issue_comments": {
          "$ref": "#/$defs/section_status"
        },
        "reviews": {
          "$ref": "#/$defs/section_status"
        },
        "review_comments": {
          "$ref": "#/$defs/section_status"
        }
      }
    }
  }
}
