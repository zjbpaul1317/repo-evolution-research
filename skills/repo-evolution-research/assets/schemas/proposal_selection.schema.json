{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/proposal_selection.schema.json",
  "title": "Deterministic proposal (issue/discussion) deep-read selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "repository",
    "activity_window",
    "quota",
    "candidates",
    "counts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "activity_window": {
      "$ref": "#/$defs/window"
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_quota",
        "issue_quota",
        "discussion_quota",
        "max_deep_entities",
        "deep_entities_used"
      ],
      "properties": {
        "proposal_quota": {
          "type": "integer",
          "minimum": 0
        },
        "issue_quota": {
          "type": "integer",
          "minimum": 0
        },
        "discussion_quota": {
          "type": "integer",
          "minimum": 0
        },
        "max_deep_entities": {
          "type": "integer",
          "minimum": 0
        },
        "deep_entities_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "selected",
        "issue_selected",
        "discussion_selected",
        "context_selected",
        "skipped_quota",
        "skipped_unchanged",
        "failed",
        "not_attempted"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "issue_selected": {
          "type": "integer",
          "minimum": 0
        },
        "discussion_selected": {
          "type": "integer",
          "minimum": 0
        },
        "context_selected": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_quota": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_attempted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "number",
        "entity_id",
        "title",
        "scope",
        "bucket",
        "score",
        "score_components",
        "role_hints",
        "selection_reason",
        "selected",
        "skipped_reason",
        "status",
        "detail_path"
      ],
      "properties": {
        "carrier": {
          "enum": [
            "issue",
            "discussion"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "bucket": {
          "enum": [
            "in_window",
            "context",
            "current_backlog"
          ]
        },
        "score": {
          "type": "integer"
        },
        "score_components": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "role_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "selection_reason": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected": {
          "type": "boolean"
        },
        "skipped_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not_attempted",
            "selected",
            "skipped_unchanged",
            "failed",
            "skipped_quota",
            "skipped_reason"
          ]
        },
        "detail_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "enum": [
        "in_window",
        "context",
        "current_backlog"
      ]
    }
  }
}
