{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/prepare_report.schema.json",
  "title": "Offline prepare summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "repository",
    "text_sources",
    "evidence_blocks",
    "evidence_derived",
    "evidence_total",
    "relations",
    "relations_derived",
    "relations_total",
    "relation_counts",
    "commit_entities",
    "external_entities",
    "evidence_truncated",
    "counts"
  ],
  "properties": {
    "schema_version": { "enum": ["1.2", "1.3"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "text_sources": { "type": "integer", "minimum": 0 },
    "evidence_blocks": { "type": "integer", "minimum": 0 },
    "evidence_derived": { "type": "integer", "minimum": 0 },
    "evidence_total": { "type": "integer", "minimum": 0 },
    "relations": { "type": "integer", "minimum": 0 },
    "relations_derived": { "type": "integer", "minimum": 0 },
    "relations_total": { "type": "integer", "minimum": 0 },
    "relations_merged": { "type": "integer", "minimum": 0 },
    "relation_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "commit_entities": { "type": "integer", "minimum": 0 },
    "external_entities": { "type": "integer", "minimum": 0 },
    "evidence_truncated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "document_key", "blocks", "kept", "problem"],
        "properties": {
          "artifact": { "type": "string", "minLength": 1 },
          "document_key": { "type": "string", "minLength": 1 },
          "blocks": { "type": "integer", "minimum": 0 },
          "kept": { "type": "integer", "minimum": 0 },
          "problem": { "const": "evidence_truncated" }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
