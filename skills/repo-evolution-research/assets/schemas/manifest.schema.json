{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/manifest.schema.json",
  "title": "Run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "tool_version",
    "state",
    "created_at",
    "updated_at",
    "repository",
    "config_hash",
    "activity_window",
    "observed",
    "collection_started_at",
    "collection_finished_at",
    "state_time_basis",
    "default_branch",
    "default_branch_sha",
    "coverage",
    "budget",
    "budget_consumed",
    "stages",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.2",
        "1.3"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "initialized",
        "collecting",
        "prepared",
        "researching",
        "validated",
        "rendered",
        "partial",
        "interrupted",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "collection_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collection_finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "state_time_basis": {
      "enum": [
        "observed_current",
        "historical_reconstructed"
      ]
    },
    "default_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_branch_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "budget_consumed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "response_bytes",
        "total_bytes",
        "deep_entities",
        "runtime_seconds"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "deep_entities": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialized",
        "collect",
        "prepare",
        "research",
        "validate",
        "render"
      ],
      "properties": {
        "initialized": {
          "$ref": "#/$defs/stage_status"
        },
        "collect": {
          "$ref": "#/$defs/stage_status"
        },
        "prepare": {
          "$ref": "#/$defs/stage_status"
        },
        "research": {
          "$ref": "#/$defs/stage_status"
        },
        "validate": {
          "$ref": "#/$defs/stage_status"
        },
        "render": {
          "$ref": "#/$defs/stage_status"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "host",
        "owner",
        "name",
        "slug",
        "canonical_url"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "const": "github.com"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 3
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_discovery_entities",
        "max_deep_entities",
        "max_relation_hops",
        "max_external_entities",
        "max_response_bytes",
        "max_total_bytes",
        "max_runtime_minutes",
        "max_pack_chars"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_discovery_entities": {
          "type": "integer",
          "minimum": 1
        },
        "max_deep_entities": {
          "type": "integer",
          "minimum": 1
        },
        "max_deep_prs": {
          "type": "integer",
          "minimum": 1
        },
        "agent_pr_reserve": {
          "type": "integer",
          "minimum": 1
        },
        "max_relation_hops": {
          "type": "integer",
          "minimum": 1
        },
        "max_external_entities": {
          "type": "integer",
          "minimum": 1
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_pack_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stage_status": {
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "partial",
        "failed",
        "skipped"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "query_scope",
        "query",
        "expected_count",
        "fetched_count",
        "pages",
        "exhausted",
        "truncation_reason",
        "remaining_cursor",
        "observed_start",
        "observed_end",
        "coverage_status",
        "discovery_status",
        "detail_status"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "query_scope": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "expected_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fetched_count": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "exhausted": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "remaining_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_start": {
          "type": "string",
          "format": "date-time"
        },
        "observed_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coverage_status": {
          "enum": [
            "complete",
            "sampled",
            "partial",
            "unavailable",
            "not_applicable",
            "not_requested"
          ]
        },
        "discovery_status": {
          "enum": [
            "complete",
            "sampled",
            "partial",
            "unavailable",
            "not_applicable",
            "not_requested"
          ]
        },
        "detail_status": {
          "enum": [
            "complete",
            "sampled",
            "partial",
            "unavailable",
            "not_applicable",
            "not_requested"
          ]
        }
      }
    }
  }
}
