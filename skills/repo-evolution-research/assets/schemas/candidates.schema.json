{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/candidates.schema.json",
  "title": "Ranked deep-read candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_version",
    "observed_at",
    "repository",
    "activity_window",
    "budget",
    "quota",
    "candidates",
    "counts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.3" },
    "rule_version": { "const": "candidates-v1" },
    "observed_at": { "type": "string", "format": "date-time" },
    "repository": { "$ref": "#/$defs/repository" },
    "activity_window": { "$ref": "#/$defs/window" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_deep_entities",
        "deep_entities_used",
        "remaining_deep_entities",
        "candidate_limit",
        "max_relation_hops",
        "max_deep_prs",
        "deep_prs_used",
        "remaining_deep_prs"
      ],
      "properties": {
        "max_deep_entities": { "type": "integer", "minimum": 0 },
        "deep_entities_used": { "type": "integer", "minimum": 0 },
        "remaining_deep_entities": { "type": "integer", "minimum": 0 },
        "candidate_limit": { "type": "integer", "minimum": 0 },
        "max_relation_hops": { "type": "integer", "minimum": 0 },
        "max_deep_prs": { "type": "integer", "minimum": 0 },
        "deep_prs_used": { "type": "integer", "minimum": 0 },
        "remaining_deep_prs": { "type": "integer", "minimum": 0 }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "lanes", "exploration_reserved", "focus_cap"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design",
            "merged_pr",
            "open_proposal",
            "release_doc",
            "exploration"
          ],
          "properties": {
            "design": { "type": "integer", "minimum": 0 },
            "merged_pr": { "type": "integer", "minimum": 0 },
            "open_proposal": { "type": "integer", "minimum": 0 },
            "release_doc": { "type": "integer", "minimum": 0 },
            "exploration": { "type": "integer", "minimum": 0 }
          }
        },
        "exploration_reserved": { "type": "integer", "minimum": 0 },
        "focus_cap": { "type": "integer", "minimum": 0 }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "rule_version",
        "entity_id",
        "kind",
        "title",
        "bucket",
        "module",
        "module_source",
        "deep_read",
        "score",
        "score_components",
        "selection_reason",
        "missing_features",
        "raw_refs",
        "evidence_ids",
        "recommended",
        "selection_lane",
        "selection_status",
        "skipped_reason",
        "agent_selected",
        "agent_depth",
        "agent_read",
        "budget_fit"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^cand-[0-9a-f]{16}$"
        },
        "rule_version": { "const": "candidates-v1" },
        "entity_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "repository",
            "pull_request",
            "issue",
            "discussion",
            "commit",
            "release",
            "doc",
            "source_file",
            "comment",
            "review"
          ]
        },
        "title": { "type": "string" },
        "bucket": {
          "enum": ["design", "merged_pr", "open_proposal", "closed_unmerged", "release_doc"]
        },
        "module": { "type": "string", "minLength": 1 },
        "module_source": {
          "enum": ["pr_files", "doc_path", "labels", "title", "scope", "release", "unknown"]
        },
        "deep_read": { "type": "boolean" },
        "score": { "type": "integer" },
        "score_components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_role",
            "explicit_relation",
            "focus_match",
            "activity",
            "recency",
            "release_mention",
            "uncovered_module",
            "merged",
            "draft"
          ],
          "properties": {
            "design_role": { "type": "integer" },
            "explicit_relation": { "type": "integer" },
            "focus_match": { "type": "integer" },
            "activity": { "type": "integer" },
            "recency": { "type": "integer" },
            "release_mention": { "type": "integer" },
            "uncovered_module": { "type": "integer" },
            "merged": { "type": "integer" },
            "draft": { "type": "integer" }
          }
        },
        "selection_reason": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "missing_features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "raw_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "json_pointer"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "json_pointer": { "type": ["string", "null"] }
            }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "recommended": { "type": "boolean" },
        "selection_lane": {
          "enum": [
            "design",
            "merged_pr",
            "open_proposal",
            "closed_unmerged",
            "release_doc",
            "exploration",
            null
          ]
        },
        "selection_status": {
          "enum": [
            "recommended",
            "already_read",
            "skipped_quota",
            "skipped_sub_budget"
          ]
        },
        "skipped_reason": {
          "enum": [
            "quota_exhausted",
            "already_read",
            "deep_pr_budget_exhausted",
            "deep_entity_budget_exhausted",
            null
          ]
        },
        "agent_selected": { "type": "boolean" },
        "agent_depth": {
          "enum": ["quick", "deep", null]
        },
        "budget_fit": {
          "enum": [
            "fetchable",
            "deep_read",
            "recorded",
            "blocked_pr_budget",
            "blocked_entity_budget"
          ]
        },
        "agent_read": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["body", "comments", "reviews", "files", "diff"],
              "properties": {
                "body": { "type": "boolean" },
                "comments": { "type": "boolean" },
                "reviews": { "type": "boolean" },
                "files": { "type": "boolean" },
                "diff": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
