{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/doc_snapshot.schema.json",
  "title": "Authoritative snapshot of a repository document at a fixed revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "repository",
    "path",
    "revision",
    "url",
    "status",
    "size",
    "chars",
    "text",
    "blob_sha256",
    "git_blob_sha",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "enum": [
        "read",
        "not_found",
        "unavailable",
        "too_large",
        "unsupported",
        "unsupported_encoding",
        "decode_error"
      ]
    },
    "size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "chars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "text": {
      "anyOf": [
        {
          "$ref": "#/$defs/text_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "blob_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_blob_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "read"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "$ref": "#/$defs/text_ref"
          },
          "blob_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unsupported_encoding"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "type": "null"
          },
          "blob_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_found",
              "unavailable",
              "too_large",
              "unsupported",
              "decode_error"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "text_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview",
        "sha256",
        "bytes",
        "preview_truncated"
      ],
      "properties": {
        "preview": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "preview_truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
