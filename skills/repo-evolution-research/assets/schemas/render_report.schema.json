{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/render_report.schema.json",
  "title": "Report render audit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "template_version",
    "research_sha256",
    "ledger_sha256",
    "validation_sha256",
    "report_path",
    "report_sha256",
    "report_chars",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "research_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_path": {
      "const": "report.md"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_chars": {
      "type": "integer",
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
