{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/selection.schema.json",
  "title": "Agent selection of entities to read in depth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "entities",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection_item"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "selection_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "reason",
        "depth",
        "read",
        "questions",
        "theme_hint"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "enum": [
            "quick",
            "deep"
          ]
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "body",
            "comments",
            "reviews",
            "files",
            "diff"
          ],
          "properties": {
            "body": {
              "type": "boolean"
            },
            "comments": {
              "type": "boolean"
            },
            "reviews": {
              "type": "boolean"
            },
            "files": {
              "type": "boolean"
            },
            "diff": {
              "type": "boolean"
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "theme_hint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
