{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/selection_report.schema.json",
  "title": "Incremental selection read report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "run_id",
    "repository",
    "selection_path",
    "budget",
    "items",
    "counts",
    "partial",
    "limitations"
  ],
  "properties": {
    "schema_version": { "enum": ["1.2", "1.3"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "repository": { "$ref": "#/$defs/repository" },
    "selection_path": { "type": "string", "minLength": 1 },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_deep_entities",
        "max_deep_prs",
        "deep_entities_before",
        "deep_entities_after",
        "deep_prs_before",
        "deep_prs_after",
        "requests",
        "pages",
        "partial"
      ],
      "properties": {
        "max_deep_entities": { "type": "integer", "minimum": 0 },
        "max_deep_prs": { "type": "integer", "minimum": 0 },
        "deep_entities_before": { "type": "integer", "minimum": 0 },
        "deep_entities_after": { "type": "integer", "minimum": 0 },
        "deep_prs_before": { "type": "integer", "minimum": 0 },
        "deep_prs_after": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "pages": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "partial": { "type": "boolean" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "comments", "reviews", "files", "diff"],
      "properties": {
        "body": { "type": "boolean" },
        "comments": { "type": "boolean" },
        "reviews": { "type": "boolean" },
        "files": { "type": "boolean" },
        "diff": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "kind",
        "depth",
        "read",
        "status",
        "skipped_reason",
        "pages",
        "requests",
        "detail_path",
        "consumed_deep_entity",
        "budget_after"
      ],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "depth": { "enum": ["quick", "deep"] },
        "read": { "$ref": "#/$defs/read" },
        "status": {
          "enum": [
            "fetched",
            "skipped_unchanged",
            "recorded",
            "not_attempted",
            "failed",
            "skipped_unsupported"
          ]
        },
        "skipped_reason": { "type": ["string", "null"] },
        "pages": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "detail_path": { "type": ["string", "null"] },
        "consumed_deep_entity": { "type": "boolean" },
        "budget_after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deep_entities", "deep_prs"],
          "properties": {
            "deep_entities": { "type": "integer", "minimum": 0 },
            "deep_prs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
