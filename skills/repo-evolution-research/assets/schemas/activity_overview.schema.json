{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-evolution-research.local/schemas/activity_overview.schema.json",
  "title": "Activity discovery overview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "activity_window",
    "observed_at",
    "repository",
    "views",
    "counts",
    "candidate_count",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.2", "1.3"]
    },
    "activity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "start",
        "end",
        "total_count",
        "incomplete",
        "pages",
        "fetched_count",
        "status"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "search",
            "list_fallback",
            "graphql"
          ]
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "total_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "incomplete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "fetched_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "complete",
            "split",
            "fallback",
            "partial"
          ]
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "kind",
        "strategy",
        "status",
        "query",
        "total_count",
        "fetched_count",
        "unique_count",
        "pages",
        "shards",
        "incomplete",
        "fallback",
        "truncation_reason",
        "remaining_cursor",
        "observed_start",
        "observed_end",
        "candidate_ids",
        "shards_detail"
      ],
      "properties": {
        "view": {
          "enum": [
            "pr_created",
            "pr_merged",
            "pr_updated",
            "issue_created",
            "issue_updated",
            "discussion_updated"
          ]
        },
        "kind": {
          "enum": [
            "pull_request",
            "issue",
            "discussion"
          ]
        },
        "strategy": {
          "enum": [
            "search",
            "list_fallback",
            "graphql",
            "mixed"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "sampled",
            "partial",
            "unavailable",
            "not_applicable",
            "not_requested"
          ]
        },
        "query": {
          "type": "string"
        },
        "total_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fetched_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_count": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "shards": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "boolean"
        },
        "fallback": {
          "type": "boolean"
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "remaining_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_start": {
          "type": "string",
          "format": "date-time"
        },
        "observed_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "shards_detail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shard"
          }
        }
      }
    }
  }
}
